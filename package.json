{
  "name": "my-ngzorro-app",
  "version": "0.0.0",
  "engines": {
    "node": ">=18.19.0",
    "npm": ">=10.2.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:prod": "http-server dist/my-ngzorro-app -p 8081 --cors -o /browser/#/login",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:my-ngzorro-app": "node dist/my-ngzorro-app/server/server.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1"
  },
  "deploy:dry": "ng build --configuration=production",
  "build:amplify": "ng build --configuration=production",
  "deploy:amplify": "amplify push",
  "test:amplify": "ng test --watch=false --browsers=ChromeHeadless",
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/cdk": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/material": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/platform-server": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@angular/ssr": "^18.2.11",
    "@ctrl/tinycolor": "^3.6.0",
    "aws-sdk": "^2.1692.0",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "my-ngzorro-app": "file:",
    "ng-zorro-antd": "^18.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.11",
    "@angular/cli": "^18.2.11",
    "@angular/compiler-cli": "^18.2.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
